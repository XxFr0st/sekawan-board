# Salin menjadi .env lalu isi nilainya:  cp .env.example .env
# Jangan pernah meng-commit file .env ke repository.

# --- Database PostgreSQL ---
POSTGRES_DB=sekawan_board
POSTGRES_USER=sekawan
POSTGRES_PASSWORD=ganti-dengan-password-kuat

# --- Backend ---
# Buat dengan: openssl rand -hex 32
JWT_SECRET=ganti-dengan-string-acak-panjang

# --- Frontend / port yang dibuka di host ---
APP_PORT=8080

# --- Hanya dipakai compose produksi (docker-compose.prod.yml) ---
IMAGE_PREFIX=ghcr.io/nama-github-anda/sekawan-board
IMAGE_TAG=latest
